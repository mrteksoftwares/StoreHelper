<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>StoreHelper.App</RootNamespace>
    <AssemblyName>StoreHelper</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StoreHelper.Core\StoreHelper.Core.csproj" />
  </ItemGroup>

  <!-- DevExpress WinForms (Framework). Derleme için DevExpress kurulu olmalı; çalışma zamanı derlemeleri çıktıya kopyalanır (DevExpress.Deps.props). -->
  <ItemGroup>
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <Reference Include="System.Security" />
    <Reference Include="System.Net.Http" />
    <Reference Include="DevExpress.Data.v26.1"><HintPath>$(DevExpressBin)DevExpress.Data.v26.1.dll</HintPath></Reference>
    <Reference Include="DevExpress.Data.Desktop.v26.1"><HintPath>$(DevExpressBin)DevExpress.Data.Desktop.v26.1.dll</HintPath></Reference>
    <Reference Include="DevExpress.Utils.v26.1"><HintPath>$(DevExpressBin)DevExpress.Utils.v26.1.dll</HintPath></Reference>
    <Reference Include="DevExpress.Utils.v26.1.UI"><HintPath>$(DevExpressBin)DevExpress.Utils.v26.1.UI.dll</HintPath></Reference>
    <Reference Include="DevExpress.Drawing.v26.1"><HintPath>$(DevExpressBin)DevExpress.Drawing.v26.1.dll</HintPath></Reference>
    <Reference Include="DevExpress.Images.v26.1"><HintPath>$(DevExpressBin)DevExpress.Images.v26.1.dll</HintPath></Reference>
    <Reference Include="DevExpress.XtraEditors.v26.1"><HintPath>$(DevExpressBin)DevExpress.XtraEditors.v26.1.dll</HintPath></Reference>
    <Reference Include="DevExpress.XtraGrid.v26.1"><HintPath>$(DevExpressBin)DevExpress.XtraGrid.v26.1.dll</HintPath></Reference>
    <Reference Include="DevExpress.XtraLayout.v26.1"><HintPath>$(DevExpressBin)DevExpress.XtraLayout.v26.1.dll</HintPath></Reference>
    <Reference Include="DevExpress.XtraBars.v26.1"><HintPath>$(DevExpressBin)DevExpress.XtraBars.v26.1.dll</HintPath></Reference>
    <Reference Include="DevExpress.XtraPrinting.v26.1"><HintPath>$(DevExpressBin)DevExpress.XtraPrinting.v26.1.dll</HintPath></Reference>
    <Reference Include="DevExpress.Printing.v26.1.Core"><HintPath>$(DevExpressBin)DevExpress.Printing.v26.1.Core.dll</HintPath></Reference>
    <Reference Include="DevExpress.XtraReports.v26.1"><HintPath>$(DevExpressBin)DevExpress.XtraReports.v26.1.dll</HintPath></Reference>
    <Reference Include="DevExpress.XtraReports.v26.1.Extensions"><HintPath>$(DevExpressBin)DevExpress.XtraReports.v26.1.Extensions.dll</HintPath></Reference>
    <Reference Include="DevExpress.DataAccess.v26.1"><HintPath>$(DevExpressBin)DevExpress.DataAccess.v26.1.dll</HintPath></Reference>
    <Reference Include="DevExpress.DataAccess.v26.1.UI"><HintPath>$(DevExpressBin)DevExpress.DataAccess.v26.1.UI.dll</HintPath></Reference>
  </ItemGroup>
</Project>
